# ── BASE DE DATOS ──────────────────────────────────────────────────────────────
# Credenciales de conexión a MySQL
# DB_HOST: dirección del servidor (localhost si corre en tu máquina)
# DB_PORT: puerto de MySQL (por defecto 3306)
# DB_USER: usuario creado en connection.sql (app_user)
# DB_PASSWORD: contraseña del usuario app_user
# DB_NAME: nombre de la base de datos creada en connection.sql
DB_HOST=localhost
DB_PORT=3306
DB_USER=paulo_user
DB_PASSWORD=Paulo2024*
DB_NAME=gestion_tareas_sena

# ── PUERTO DEL SERVIDOR ─────────────────────────────────────────────────────────
# Puerto donde arranca el servidor Express.
# Si no se define, usa el valor por defecto 3000.
PORT=

# ── JWT ────────────────────────────────────────────────────────────────────────
# Clave secreta para firmar los accessToken (vida corta: 1h)
# Usar una cadena larga y aleatoria — nunca compartir este valor
JWT_SECRET=supersecretoaccesstoken

# Clave secreta para firmar los refreshToken (vida larga: 7d)
# IMPORTANTE: debe ser diferente a JWT_SECRET
JWT_REFRESH_SECRET=supersecretojwtrt

# Tiempo de vida de cada token
# Ejemplos: 1h, 15m, 7d, 30d
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── MAILTRAP SMTP ──────────────────────────────────────────────────────────────
# Servicio de testing de correos — los correos NO llegan a bandejas reales,
# aparecen en el sandbox de mailtrap.io (ideal para desarrollo y pruebas)
# Obtener las credenciales desde: mailtrap.io → Sandboxes → My Sandbox → Integration → SMTP
# MAILTRAP_HOST: siempre es sandbox.smtp.mailtrap.io
# MAILTRAP_PORT: usar 2525 (también acepta 25, 465 y 587)
# MAILTRAP_USER: username que aparece en la pestaña SMTP de Mailtrap
# MAILTRAP_PASS: password que aparece en la pestaña SMTP de Mailtrap
# MAILTRAP_FROM: dirección de origen del correo (puede ser cualquier valor)
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USER=
MAILTRAP_PASS=
MAILTRAP_FROM=